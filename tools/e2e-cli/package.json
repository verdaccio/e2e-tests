{
  "name": "@verdaccio/e2e-cli",
  "version": "2.10.2",
  "type": "module",
  "license": "MIT",
  "description": "CLI tool to run Verdaccio e2e tests against any running registry",
  "repository": {
    "type": "git",
    "url": "https://github.com/verdaccio/e2e-tests",
    "directory": "tools/e2e-cli"
  },
  "files": [
    "bin",
    "Cargo.lock",
    "Cargo.toml",
    "scripts",
    "src"
  ],
  "bin": {
    "verdaccio-e2e": "./bin/e2e-cli.js"
  },
  "main": "./build/cjs/index.cjs",
  "module": "./build/esm/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.cjs",
      "types": "./build/index.d.ts"
    }
  },
  "scripts": {
    "build": "cargo build --release && node scripts/build-js-package.mjs",
    "postinstall": "cargo build --release && node scripts/build-js-package.mjs",
    "clean": "rimraf build target",
    "fmt:check": "cargo fmt -- --check",
    "clippy": "cargo clippy --all-targets -- -D warnings",
    "docs": "cargo doc --no-deps"
  },
  "dependencies": {},
  "devDependencies": {}
}
